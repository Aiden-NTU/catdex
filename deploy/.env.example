# Copy to deploy/.env, set restrictive permissions, and replace every value.
CATDEX_DOMAIN=api.example.com
ACME_EMAIL=ops@example.com

POSTGRES_PASSWORD=generate-a-long-random-password
CATDEX_ENROLLMENT_SECRET=generate-at-least-32-random-characters
CATDEX_ENROLLMENT_COOLDOWN_SECONDS=30

NAKAMA_SERVER_KEY=generate-a-long-random-server-key
NAKAMA_RUNTIME_HTTP_KEY=generate-a-separate-long-random-runtime-key
NAKAMA_SESSION_ENCRYPTION_KEY=generate-32-or-more-random-characters
NAKAMA_REFRESH_ENCRYPTION_KEY=generate-another-32-or-more-random-characters
NAKAMA_CONSOLE_USERNAME=ops-admin
NAKAMA_CONSOLE_PASSWORD=generate-a-long-random-console-password
NAKAMA_CONSOLE_SIGNING_KEY=generate-a-separate-long-random-signing-key

GRAFANA_ADMIN_USER=ops-admin
GRAFANA_ADMIN_PASSWORD=generate-a-long-random-grafana-password
