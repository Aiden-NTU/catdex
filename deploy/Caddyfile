{
	email {$ACME_EMAIL}
	admin off
}

{$CATDEX_DOMAIN} {
	encode zstd gzip

	@api path /v2/* /healthcheck /ws
	handle @api {
		reverse_proxy nakama:7350
	}

	handle {
		respond "not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		output stdout
		format json
	}
}
